{
  "name": "Purview DLP Report",
  "dataColors": [
    "#B11F4B",
    "#D9577A",
    "#7A1534",
    "#E992AB",
    "#9A1A41",
    "#C2335F",
    "#5C0F27",
    "#F2C4D1",
    "#5C5C5C",
    "#919191"
  ],
  "background": "#FFFFFF",
  "foreground": "#242424",
  "tableAccent": "#B11F4B",
  "good": "#16A34A",
  "neutral": "#F59E0B",
  "bad": "#DC2626",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#242424"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#242424"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#242424"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5C5C5C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#242424"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5C5C5C"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#919191"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#EEEEEE"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#5C5C5C"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#5C5C5C"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEEEEE"
              }
            },
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#DEDEDE"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#B11F4B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "outline": "Bottom only"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#242424"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FBF6F7"
              }
            },
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#242424"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEEEEE"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#B11F4B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#242424"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "backColorSecondary": {
              "solid": {
                "color": "#FBF6F7"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#242424"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#DEDEDE"
              }
            },
            "textSize": 10
          }
        ],
        "header": [
          {
            "show": false
          }
        ],
        "date": [
          {
            "fontColor": {
              "solid": {
                "color": "#242424"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 26,
            "color": {
              "solid": {
                "color": "#242424"
              }
            },
            "labelDisplayUnits": 1
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F7F4EF"
              }
            }
          }
        ],
        "background": [
          {
            "transparency": 0
          }
        ]
      }
    }
  }
}
